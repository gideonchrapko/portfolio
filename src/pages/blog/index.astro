---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog" description="Writing by Gideon Chrapko">
	<div class="mx-auto max-w-2xl px-6 py-10">
		<h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">Writing</h1>
		<p class="mt-2 text-sm text-zinc-500">Thoughts, notes, and updates.</p>

		<ul class="mt-10 space-y-8">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="group block">
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									class="mb-3 w-full rounded-lg transition-shadow group-hover:shadow-md"
								/>
							)}
							<time class="font-dmmono text-xs uppercase tracking-widest text-zinc-400">
								<FormattedDate date={post.data.pubDate} />
							</time>
							<h2 class="mt-1 text-xl font-semibold tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600">
								{post.data.title}
							</h2>
							<p class="mt-1 text-sm text-zinc-600">{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
