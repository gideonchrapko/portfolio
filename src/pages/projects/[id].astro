---
import Layout from '../../layouts/Layout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import LottiePlayer from '../../components/LottiePlayer.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, FALLBACK_CATEGORY, type CategorySlug } from '../../data/categories';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
	title,
	description,
	date,
	categories: rawCategories,
	roles,
	tools,
	overview,
	sections,
	images,
	videos,
	pdfs,
	url,
	showVideoControls,
	image,
} = entry.data;
const videoControls = showVideoControls ?? false;
const categorySlugs: CategorySlug[] = (
	rawCategories?.length ? rawCategories : [FALLBACK_CATEGORY]
).filter(
	(slug): slug is CategorySlug =>
		typeof slug === 'string' && slug in CATEGORIES
);
const shareDescription = description ?? overview?.slice(0, 160) ?? title;
const shareImage = image ?? images?.[0] ?? undefined;

function sectionId(section: (typeof sections)[number]): string {
	if (section.id) return section.id;
	return section.title
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
}

function muxPlaybackId(idOrUrl: string): string {
	if (idOrUrl.startsWith('http')) {
		const match = idOrUrl.match(/stream\.mux\.com\/([^/?]+)/);
		return match ? match[1] : idOrUrl;
	}
	return idOrUrl;
}
---

<Layout title={title} description={shareDescription} image={shareImage}>
	<article class="px-4 py-8 font-sans">
		<header>
			<h1 class="animate-rise font-display text-3xl font-medium leading-[0.95] tracking-tight text-gray-900 sm:text-5xl">{title}</h1>
			<div class="animate-rise mt-1 flex flex-wrap items-center gap-2" style="animation-delay: 100ms">
				{date && <span class="text-sm text-gray-500">{date.toLocaleDateString()}</span>}
				{categorySlugs.map((slug) => (
					<CategoryBadge category={slug} static />
				))}
			</div>
			{
				url && (
					<p class="mt-3">
						<a
							href={url}
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex items-center gap-2 rounded-lg px-0.5 text-xl font-semibold text-gray-900 no-underline transition-colors hover:bg-gray-300/40"
						>
							<span class="underline decoration-gray-400 hover:decoration-gray-600">View site</span>
							<span
								class="inline-block text-xl no-underline transition-transform duration-200 -rotate-45 group-hover:rotate-0"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					</p>
				)
			}
			{description && <p class="mt-1 text-gray-600">{description}</p>}
		</header>

		{
			image && (
				<div
					class="animate-rise mt-8 -mx-4 sm:-mx-0 sm:rounded-lg overflow-hidden bg-white"
					style="animation-delay: 200ms"
				>
					<img src={image} alt="" class="w-full object-cover" loading="eager" />
				</div>
			)
		}

		{
			(roles?.length || tools?.length || overview) && (
				<div class="mt-6 space-y-3 text-sm">
					{roles?.length && (
						<p>
							<span class="font-medium text-gray-500">ROLE</span>
							<br />
							<span class="text-gray-900">{roles.join(' · ')}</span>
						</p>
					)}
					{tools?.length && (
						<p>
							<span class="font-medium text-gray-500">TOOLS</span>
							<br />
							<span class="text-gray-900">{tools.join(' · ')}</span>
						</p>
					)}
					{overview && (
						<div>
							<p class="font-medium text-gray-500">PROJECT OVERVIEW</p>
							<p class="mt-1 whitespace-pre-line text-gray-900">{overview}</p>
						</div>
					)}
				</div>
			)
		}

		{
			videos?.length || sections?.length || images?.length || pdfs?.length ? (
				<div class="mt-10 space-y-10">
					{videos?.length ? (
						<div class="w-full space-y-4">
							{videos.map((video) => {
								const showControls =
									typeof video === 'object' && video.controls !== undefined ? video.controls : videoControls;
								const attrs = showControls ? { controls: true } : { autoplay: true, muted: true, loop: true };
								const videoClass = showControls
? 'w-full max-w-[600px] mx-auto block rounded-lg'
								: 'w-full rounded-lg';
								if (typeof video === 'object' && video.mux) {
									const player = (
										<mux-player
											playback-id={muxPlaybackId(video.mux)}
											class="w-full rounded-lg"
											stream-type="on-demand"
											autoplay={showControls ? undefined : 'muted'}
											loop={showControls ? undefined : true}
											muted={showControls ? undefined : true}
											default-hidden-captions
										/>
									);
									if (video.backgroundImage) {
										return (
											<div
												class="w-full rounded-lg bg-cover bg-center px-4 py-12 sm:py-20"
												style={`background-image: url(${video.backgroundImage})`}
											>
												<div class="mx-auto w-full max-w-[900px] overflow-hidden rounded-lg">
													{player}
												</div>
											</div>
										);
									}
									return <div class="w-full max-w-[600px] mx-auto">{player}</div>;
								}
								return typeof video === 'string' ? (
									<video src={video} class={videoClass} playsinline {...attrs} />
								) : (
									<video class={videoClass} playsinline {...attrs}>
										{video.webm && <source type="video/webm" src={video.webm} />}
										{video.mp4 && <source type="video/mp4" src={video.mp4} />}
									</video>
								);
							})}
						</div>
					) : null}

					{pdfs?.length ? (
						<div class="space-y-8">
							{pdfs.map((pdf) => (
								<div class="overflow-hidden rounded-lg border border-gray-400/20 bg-white">
									<div class="flex items-center justify-between gap-2 px-4 py-2.5 text-sm">
										<span class="truncate font-medium text-gray-900">{pdf.split('/').pop()}</span>
										<a
											href={pdf}
											target="_blank"
											rel="noopener noreferrer"
											class="shrink-0 text-blue-600 underline"
										>
											Open in new tab →
										</a>
									</div>
									<iframe
										src={pdf}
										title={pdf.split('/').pop()}
										class="h-[75vh] w-full border-0"
										loading="lazy"
									/>
								</div>
							))}
						</div>
					) : null}

					{sections?.length ? (
						<div class="space-y-16">
							{sections.map((section) => (
								<section id={sectionId(section)}>
									<h2 class="text-lg font-semibold text-gray-900 scroll-mt-24">
										{section.id && `${section.id} - `}
										{section.title}
									</h2>
									{section.description && (
										<p class="mt-3 whitespace-pre-line text-sm text-gray-700">{section.description}</p>
									)}
									{section.link && (
										<p class="mt-2">
											<a
												href={section.link}
												target="_blank"
												rel="noopener noreferrer"
												class="text-blue-600 underline"
											>
												View link →
											</a>
										</p>
									)}
									{section.images?.length === 1 ? (
										<div class="mt-12 flex justify-center">
											<img
												src={section.images[0]}
												alt=""
												class="w-full max-w-3xl rounded-lg object-contain"
												loading="lazy"
											/>
										</div>
									) : section.images?.length ? (
										<div class="project-gallery mt-12">
											{section.images.map((src) => (
												<div class="project-gallery__item">
													<img src={src} alt="" class="w-full h-auto rounded-lg" loading="lazy" />
												</div>
											))}
										</div>
									) : null}
									{section.videos?.length ? (
										<div class="mt-3 space-y-2">
											{section.videos.map((video) => {
												const showControls =
													typeof video === 'object' && video.controls !== undefined
														? video.controls
														: videoControls;
												const attrs = showControls ? { controls: true } : { loop: true };
												const videoClass = showControls
													? 'w-full max-w-[600px] mx-auto block rounded-lg'
													: 'w-full rounded-lg';
												if (typeof video === 'object' && video.mux) {
													const player = (
														<mux-player
															playback-id={muxPlaybackId(video.mux)}
															class="w-full rounded-lg"
															stream-type="on-demand"
															autoplay={showControls ? undefined : 'muted'}
															loop={showControls ? undefined : true}
															muted={showControls ? undefined : true}
															default-hidden-captions
														/>
													);
													if (video.backgroundImage) {
														return (
															<div
																class="w-full rounded-lg bg-cover bg-center px-4 py-12 sm:py-20"
																style={`background-image: url(${video.backgroundImage})`}
															>
																<div class="mx-auto w-full max-w-[900px] overflow-hidden rounded-lg">
																	{player}
																</div>
															</div>
														);
													}
													return <div class="w-full max-w-[600px] mx-auto">{player}</div>;
												}
												return typeof video === 'string' ? (
													<video src={video} class={videoClass} playsinline {...attrs} />
												) : (
													<video class={videoClass} playsinline {...attrs}>
														{video.webm && <source type="video/webm" src={video.webm} />}
														{video.mp4 && <source type="video/mp4" src={video.mp4} />}
													</video>
												);
											})}
										</div>
									) : null}
									{section.pdf && (
										<div class="mt-8 overflow-hidden rounded-lg border border-gray-400/20 bg-white">
											<div class="flex items-center justify-between gap-2 px-4 py-2.5 text-sm">
												<span class="truncate font-medium text-gray-900">
													{section.pdf.split('/').pop()}
												</span>
												<a
													href={section.pdf}
													target="_blank"
													rel="noopener noreferrer"
													class="shrink-0 text-blue-600 underline"
												>
													Open in new tab →
												</a>
											</div>
											<iframe
												src={section.pdf}
												title={section.pdf.split('/').pop()}
												class="h-[75vh] w-full border-0"
												loading="lazy"
											/>
										</div>
									)}
									{section.embed && (
										<div class="mt-8 w-full">
											<div class="relative w-full overflow-hidden rounded-lg" style="aspect-ratio: 16/9;">
												<iframe
													src={section.embed}
													class="absolute inset-0 h-full w-full border-0"
													loading="lazy"
													allowfullscreen
												/>
											</div>
										</div>
									)}
									{section.lottie && (
										<div class="mt-8 flex flex-wrap justify-center gap-6">
											{(Array.isArray(section.lottie) ? section.lottie : [section.lottie]).map(
												(url) => <LottiePlayer url={url} />
											)}
										</div>
									)}
								</section>
							))}
						</div>
					) : images?.length ? (
						<div class="project-gallery">
							{images.map((src) => (
								<div class="project-gallery__item">
									<img src={src} alt="" class="w-full h-auto rounded-lg" loading="lazy" />
								</div>
							))}
						</div>
					) : null}
				</div>
			) : null
		}

		<div class="md-body">
			<Content />
		</div>
	</article>
</Layout>

<script>
	import '@mux/mux-player';
</script>

<style>
	mux-player {
		border-radius: 0.5rem;
		overflow: hidden;
	}

	.animate-rise {
		animation: rise-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.animate-rise {
			animation: none;
			opacity: 1;
		}
	}
	.project-gallery {
		column-count: 2;
		column-gap: 2rem;
	}
	.project-gallery__item {
		break-inside: avoid;
		margin-bottom: 2rem;
	}
	.project-gallery__item img {
		display: block;
		vertical-align: top;
	}
	@media (max-width: 640px) {
		.project-gallery {
			column-count: 1;
			column-gap: 0;
		}
	}
</style>
