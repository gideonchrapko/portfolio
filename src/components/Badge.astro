---
interface Props {
	/** Label shown inside the badge. */
	text: string;
	/** Optional URL. When set the badge renders as a link. */
	href?: string;
	/** Light grey background with white text. Overrides `color`. */
	ghost?: boolean;
	/** Tailwind colour to use for the badge background. */
	color?: ColorName;
}

type ColorName = keyof typeof COLORS;

const COLORS = {
	slate: { bg: 'bg-slate-600', text: 'text-zinc-900' },
	gray: { bg: 'bg-gray-600', text: 'text-zinc-900' },
	zinc: { bg: 'bg-zinc-600', text: 'text-zinc-900' },
	neutral: { bg: 'bg-neutral-600', text: 'text-zinc-900' },
	stone: { bg: 'bg-stone-600', text: 'text-zinc-900' },
	red: { bg: 'bg-red-600', text: 'text-zinc-900' },
	orange: { bg: 'bg-orange-600', text: 'text-zinc-900' },
	amber: { bg: 'bg-amber-500', text: 'text-zinc-900' },
	yellow: { bg: 'bg-yellow-500', text: 'text-zinc-900' },
	lime: { bg: 'bg-lime-500', text: 'text-zinc-900' },
	green: { bg: 'bg-green-600', text: 'text-zinc-900' },
	emerald: { bg: 'bg-emerald-600', text: 'text-zinc-900' },
	teal: { bg: 'bg-teal-600', text: 'text-zinc-900' },
	cyan: { bg: 'bg-cyan-600', text: 'text-zinc-900' },
	sky: { bg: 'bg-sky-600', text: 'text-zinc-900' },
	blue: { bg: 'bg-blue-600', text: 'text-zinc-900' },
	indigo: { bg: 'bg-indigo-600', text: 'text-zinc-900' },
	violet: { bg: 'bg-violet-600', text: 'text-zinc-900' },
	purple: { bg: 'bg-purple-600', text: 'text-zinc-900' },
	fuchsia: { bg: 'bg-fuchsia-600', text: 'text-zinc-900' },
	pink: { bg: 'bg-pink-600', text: 'text-zinc-900' },
	rose: { bg: 'bg-rose-600', text: 'text-zinc-900' },
	acid: { bg: 'bg-[#C8FF00]', text: 'text-zinc-900' },
	azure: { bg: 'bg-[#48BAF3]', text: 'text-zinc-900' },
	gold: { bg: 'bg-[#FFD400]', text: 'text-zinc-900' },
	mint: { bg: 'bg-[#00FFA6]', text: 'text-zinc-900' },
	'hot-pink': { bg: 'bg-[#FF00C3]', text: 'text-zinc-900' },
} as const;

const GHOST = { bg: 'bg-gray-200', text: 'text-zinc-900' };

const { text, href, ghost = false, color = 'slate' } = Astro.props;

const chosen = ghost ? GHOST : COLORS[color];

const Tag = href ? 'a' : 'span';
const external = href?.startsWith('http');
const extraAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const classes = [
	'relative inline-flex w-fit items-center rounded-none px-2 py-[3px] cursor-pointer',
	'font-dmmono text-[14px] font-normal leading-tight no-underline',
	chosen.bg,
	chosen.text,
	'transition-[filter] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]',
	'hover:brightness-90',
	'before:pointer-events-none before:absolute before:-top-1.5 before:-left-1.5 before:size-1.5',
	'before:bg-inherit before:content-[""]',
];
---

<Tag
	class={classes.join(' ')}
	data-badge
	{...extraAttrs}
	{...(href ? { href } : {})}
>
	{text}
</Tag>
