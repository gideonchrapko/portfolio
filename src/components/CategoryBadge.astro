---
import { CATEGORIES, FALLBACK_CATEGORY, type CategorySlug } from '../data/categories';
import Badge from './Badge.astro';

interface Props {
	category: CategorySlug;
	/** Reserved for a future category listing page. */
	static?: boolean;
}

const { category } = Astro.props;

const resolved: CategorySlug = category in CATEGORIES ? category : FALLBACK_CATEGORY;
const meta = CATEGORIES[resolved];
---

<Badge text={meta.label} color={meta.color} />
