---
interface Props {
	/** URL of a Lottie JSON animation file. */
	url: string;
	className?: string;
}

const { url, className } = Astro.props;
---

<div class:list={['lottie-player', className]} data-src={url}></div>

<script>
	import lottie from 'lottie-web';

	const players = document.querySelectorAll<HTMLElement>('[data-src]');
	players.forEach((el) => {
		const url = el.dataset.src;
		if (!url) return;
		lottie.loadAnimation({
			container: el,
			renderer: 'svg',
			loop: true,
			autoplay: true,
			path: url,
		});
	});
</script>

<style is:global>
	.lottie-player {
		width: 100%;
	}
	.lottie-player svg {
		width: 100%;
		height: auto;
	}
</style>
