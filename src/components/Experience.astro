---
import Badge from './Badge.astro';
import CategoryBadge from './CategoryBadge.astro';
import type { CategorySlug } from '../data/categories';
import { experience } from '../data/experience';
import { tagLabelsBySlug } from '../data/tags';

const capabilities: { category: CategorySlug }[] = [
  { category: 'graphic-design' },
  { category: 'motion' },
  { category: 'engineering' },
];
---

<section id="experience" class="mt-20 scroll-mt-24 font-sans" aria-labelledby="experience-heading">
  <header class="mb-8">
    <h2 id="experience-heading" class="mt-2 font-display text-4xl font-semibold tracking-tight text-gray-900">
      Where I've worked
    </h2>

    <div class="mt-4 flex flex-wrap items-center gap-x-0 gap-y-2">
      {
        capabilities.map((cap, i) => (
          <>
            <CategoryBadge category={cap.category} />
            {i < capabilities.length - 1 && (
              <span class="select-none px-1 text-gray-400" aria-hidden="true">
                ·
              </span>
            )}
          </>
        ))
      }
    </div>
  </header>

  <div class="space-y-10">
    {
      experience.map((job) => (
        <article class="grid grid-cols-1 gap-4 py-6 sm:grid-cols-[minmax(0,13rem)_1fr] sm:items-start sm:gap-8">
          <div
            class={`border-l-2 pl-4 text-sm text-gray-500 sm:pt-0.5 ${
              job.current ? 'border-emerald-500' : 'border-gray-200'
            }`}
          >
            <p class="whitespace-nowrap tabular-nums">
              {job.start} – {job.end}
            </p>
            <p class="mt-0.5 whitespace-nowrap text-xs font-medium text-gray-400">{job.duration}</p>
          </div>

          <div>
            <div class="text-base">
              <div class="flex flex-wrap items-center gap-2">
                {job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1.5 font-display text-xl font-semibold text-gray-900 no-underline transition-colors hover:text-gray-600"
                  >
                    <span class="underline decoration-gray-400 underline-offset-4 group-hover:decoration-gray-900"
                      >{job.company}</span
                    >
                    <span
                      class="inline-block text-base text-gray-400 no-underline transition-transform duration-200 group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </a>
                ) : (
                  <span class="font-display text-xl font-semibold text-gray-900">{job.company}</span>
                )}
                {job.current && (
                  <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true" />
                    Current
                  </span>
                )}
              </div>
              <p class="mt-1 font-medium text-gray-700">{job.role}</p>
            </div>
            <p class="mt-1 text-sm text-gray-400">
              {job.type}
              {job.location ? ` · ${job.location}` : ''}
            </p>

            {job.scope.length > 0 && (
              <ul class="mt-4 list-none space-y-2 pl-0 text-sm leading-relaxed text-gray-600">
                {job.scope.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {job.capabilities.length > 0 && (
              <div class="mt-5">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-400">Capabilities</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {job.capabilities.map((slug) => (
                    <a
                      href={`/projects?tag=${encodeURIComponent(slug)}`}
                      class="inline-flex no-underline transition-opacity duration-200 opacity-75 hover:opacity-100"
                    >
                      <Badge label={tagLabelsBySlug[slug] ?? slug} variant="secondary" link />
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
